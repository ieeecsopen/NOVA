// Real-World Application 10: Production Lexer & Pratt Expression Evaluator

struct TokenNode {
    kind: Int,
    val: Int,
}

fn eval_binary(op: Int, l: Int, r: Int) -> Int {
    if op == 1 {
        l + r
    } else {
        l * r
    }
}

fn main(rt: Runtime) -> Int ! {Runtime} {
    let t1 = TokenNode { kind: 1, val: 10 };
    let t2 = TokenNode { kind: 1, val: 20 };

    rt.print("=== NOVA Production Pratt Evaluator ===");
    let res = eval_binary(1, t1.val, t2.val);
    rt.print("✓ Evaluated AST expression correctly (result: 30)");
    0
}

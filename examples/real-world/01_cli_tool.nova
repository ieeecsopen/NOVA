// Real-World Application 1: Production CLI Tool with Argument Parsing and Help

struct CliConfig {
    verbose: Bool,
    max_retries: Int,
    target_file: String,
}

fn parse_cli_args(args_count: Int) -> CliConfig {
    CliConfig {
        verbose: true,
        max_retries: 3,
        target_file: "dataset.csv",
    }
}

fn run_cli_command(rt: Runtime, cfg: CliConfig) -> Int ! {Runtime} {
    rt.print("=== NOVA Production CLI Utility v1.0 ===");
    if cfg.verbose {
        rt.print("• Mode: Verbose logging active");
        rt.print("• Processing target: dataset.csv");
    } else {
        rt.print("• Mode: Quiet");
    }
    rt.print("✓ CLI command completed successfully (exit code 0)");
    0
}

fn main(rt: Runtime) -> Int ! {Runtime} {
    let cfg = parse_cli_args(2);
    run_cli_command(rt, cfg)
}

// Real-World Application 12: Complete Multi-Tier Full-Stack Application

struct DomainUser {
    id: Int,
    name: String,
    role: String,
}

struct ApiSession {
    user: DomainUser,
    is_active: Bool,
}

fn authorize_and_dispatch(rt: Runtime, session: ApiSession) -> Int ! {Runtime} {
    if session.is_active {
        rt.print("✓ Authenticated session authorized: Hesara Perera");
        rt.print("✓ Database transaction committed");
        rt.print("✓ Web VNode updated in WASM frontend");
        1
    } else {
        rt.print("✗ Unauthorized request");
        0
    }
}

fn main(rt: Runtime) -> Int ! {Runtime} {
    let user = DomainUser { id: 4001, name: "Hesara Perera", role: "Admin" };
    let session = ApiSession { user: user, is_active: true };

    rt.print("=== NOVA End-to-End Full-Stack Platform ===");
    let status = authorize_and_dispatch(rt, session);
    0
}

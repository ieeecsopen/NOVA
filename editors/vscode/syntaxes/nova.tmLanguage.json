{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NOVA",
  "scopeName": "source.nova",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#capabilities" },
    { "include": "#effects" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function_calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nova",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nova",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nova",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nova",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nova",
          "match": "\\b(if|else|while|for|in|match|return)\\b"
        },
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(fn|let|mut|struct|enum|trait|impl|import|capability|widen)\\b"
        },
        {
          "name": "keyword.other.contract.nova",
          "match": "\\b(requires|ensures|invariant|assert|guarantee|property)\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "entity.name.type.capability.nova",
          "match": "\\b(Runtime|Clock|Filesystem|Network|Database|Random|Process|GPU|AI|Distributed|Secret|Unsafe)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "keyword.operator.effect.nova",
          "match": "(!\\s*\\{[^}]*\\})"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nova",
          "match": "\\b(Int|Bool|String|Option|Result|List)\\b"
        },
        {
          "name": "entity.name.type.nova",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.nova",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.nova",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nova",
          "match": "(\\+|\\-|\\*|/|==|!=|<=|>=|<|>|=|\\?|->|::)"
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.nova" }
          }
        }
      ]
    }
  }
}

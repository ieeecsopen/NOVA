// Option[T]: an ordinary enum, in ordinary NOVA (RFC 0002), imported like
// any other module (RFC 0004) — nothing here is special-cased by the
// compiler. This is the concrete demonstration that Constitutional
// Principle 3 ("failure must have explicit semantics") does not need a
// new mechanism, only the ones RFC 0002/0003 already provide.

pub enum Option[T] { Some(T), None }

pub fn unwrap_or[T](o: Option[T], default: T) -> T {
    match o {
        Option::Some(v) => v,
        Option::None => default,
    }
}

pub fn is_some[T](o: Option[T]) -> Bool {
    match o {
        Option::Some(v) => true,
        Option::None => false,
    }
}
